{
  "name": "pi-message-ingest",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "author": "Martin Bundgaard",
  "repository": { "type": "git", "url": "git+https://github.com/mbundgaard/pi-message-ingest.git" },
  "homepage": "https://github.com/mbundgaard/pi-message-ingest#readme",
  "bugs": { "url": "https://github.com/mbundgaard/pi-message-ingest/issues" },
  "description": "Push raw text to an explicitly mapped Pi session through an authenticated listener, with an optional managed Cloudflare Tunnel.",
  "type": "module",
  "keywords": ["pi-package", "pi-extension", "http", "webhook", "cloudflare-tunnel"],
  "files": ["src", "README.md", "docs", "LICENSE", "SECURITY.md", "CHANGELOG.md"],
  "pi": { "extensions": ["./src/index.ts"] },
  "engines": { "node": ">=22.19.0" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "validate": "npm run typecheck && npm test",
    "pack:check": "npm pack --dry-run --ignore-scripts"
  },
  "peerDependencies": { "@earendil-works/pi-coding-agent": "*", "typebox": "*" },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.23.0",
    "typebox": "^1.3.7",
    "typescript": "^5.9.0"
  },
  "overrides": { "@earendil-works/pi-coding-agent": { "undici": "8.12.2" } }
}
